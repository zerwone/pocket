{
  "name": "@zerwone/pocket",
  "version": "0.3.0",
  "description": "Keep Claude Code and Codex working when they hit a usage limit: a local router that moves them to your next API key (Groq, NVIDIA, OpenRouter or your own).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pocket": "dist/main.js"
  },
  "files": [
    "dist",
    "providers.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.2.0",
    "smol-toml": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
    "codex",
    "claude-desktop",
    "usage-limit",
    "rate-limit",
    "429",
    "fallback",
    "failover",
    "byok",
    "llm-router",
    "ai-gateway",
    "free-llm",
    "groq",
    "openrouter",
    "nvidia-nim",
    "gemini",
    "anthropic",
    "openai",
    "keychain",
    "coding-agents",
    "cli"
  ],
  "homepage": "https://zerwone.github.io/pocket/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerwone/pocket.git"
  },
  "bugs": {
    "url": "https://github.com/zerwone/pocket/issues"
  },
  "author": "Mohamad Aljadaan (ZerwOne)"
}
