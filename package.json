    "cerebras",
    "nvidia-nim",
    "keychain",
    "coding-agents",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/zerwone/pocket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerwone/pocket.git"
